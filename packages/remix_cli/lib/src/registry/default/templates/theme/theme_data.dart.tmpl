  /// already read from; use [copyWith] to derive a changed theme instead.
  Map<MixToken<Object?>, Object> get tokens =>
      Map<MixToken<Object?>, Object>.unmodifiable(<MixToken<Object?>, Object>{
        {{typePrefix}}Tokens.background: background,
        {{typePrefix}}Tokens.foreground: foreground,
        {{typePrefix}}Tokens.primary: primary,
        {{typePrefix}}Tokens.primaryForeground: primaryForeground,
        {{typePrefix}}Tokens.secondary: secondary,
