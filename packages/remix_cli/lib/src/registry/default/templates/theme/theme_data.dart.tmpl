        {{typePrefix}}Tokens.mutedForeground: mutedForeground,
        {{typePrefix}}Tokens.accent: accent,
        {{typePrefix}}Tokens.accentForeground: accentForeground,
        {{typePrefix}}Tokens.destructive: destructive,
        {{typePrefix}}Tokens.destructiveForeground: destructiveForeground,
        {{typePrefix}}Tokens.border: border,
        {{typePrefix}}Tokens.focusRing: focusRing,
        {{typePrefix}}Tokens.radius: radius,
