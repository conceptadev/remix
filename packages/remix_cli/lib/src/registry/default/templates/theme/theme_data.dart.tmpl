      destructiveForeground = const Color(0xFFFFFFFF),
      border = const Color(0xFFE5E5E5),
      focusRing = const Color(0xFF737373),
      radius = const Radius.circular(8);

  /// The neutral dark theme.
  const {{typePrefix}}ThemeData.dark()
