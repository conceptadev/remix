  /// Value for [{{typePrefix}}Tokens.background].
  final Color background;

  /// Value for [{{typePrefix}}Tokens.foreground].
  final Color foreground;

  /// Value for [{{typePrefix}}Tokens.primary].
  final Color primary;

  /// Value for [{{typePrefix}}Tokens.primaryForeground].
  final Color primaryForeground;

  /// Value for [{{typePrefix}}Tokens.secondary].
  final Color secondary;

  /// Value for [{{typePrefix}}Tokens.secondaryForeground].
  final Color secondaryForeground;

  /// Value for [{{typePrefix}}Tokens.muted].
  final Color muted;

  /// Value for [{{typePrefix}}Tokens.mutedForeground].
  final Color mutedForeground;

  /// Value for [{{typePrefix}}Tokens.accent].
  final Color accent;

  /// Value for [{{typePrefix}}Tokens.accentForeground].
  final Color accentForeground;

  /// Value for [{{typePrefix}}Tokens.destructive].
  final Color destructive;

  /// Value for [{{typePrefix}}Tokens.destructiveForeground].
  final Color destructiveForeground;

  /// Value for [{{typePrefix}}Tokens.border].
