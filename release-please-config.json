{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "dart",
  "skip-github-release": true,
  "skip-labeling": true,
  "include-component-in-tag": false,
  "packages": {
    "packages/remix": {
      "package-name": "remix",
      "extra-files": [
        {
          "type": "generic",
          "path": "/packages/remix_fortal/pubspec.yaml"
        },
        {
          "type": "generic",
          "path": "/packages/carbon/pubspec.yaml"
        }
      ]
    },
    "packages/remix_fortal": {
      "package-name": "remix_fortal",
      "include-component-in-tag": true
    }
  }
}
